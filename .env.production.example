# Copier ce fichier en ".env" à la racine du projet sur le VPS, puis remplir les valeurs.

# Ton nom de domaine (sans http:// ni www.)
DOMAIN=sthecroh.com

# Mot de passe PostgreSQL — choisis-en un long et aléatoire
POSTGRES_PASSWORD=change-moi-en-un-mot-de-passe-fort

# Secrets JWT — génère avec: openssl rand -hex 32 (lance la commande deux fois, une par ligne)
JWT_ACCESS_SECRET=change-moi
JWT_REFRESH_SECRET=change-moi

# Optionnel — laisser vide si non utilisé pour l'instant
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
